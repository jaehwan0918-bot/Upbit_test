{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron-monitor",
      "schedule": "0 0 * * *"
    }
  ],
  "functions": {
    "api/scanner.js": {
      "maxDuration": 60
    }
  }
}